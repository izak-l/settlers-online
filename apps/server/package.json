{
  "name": "@settlers/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs",
    "start:prod": "node --enable-source-maps dist/server.mjs"
  },
  "dependencies": {
    "@settlers/engine": "workspace:*",
    "@settlers/maps": "workspace:*",
    "@settlers/protocol": "workspace:*",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "esbuild": "0.28.2",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
