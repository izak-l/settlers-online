# Copy to ~/settlers/.env on the VM and fill in. chmod 600 .env. Never commit the real file.
# Compose reads it for ${...} values, and the server reads it as its environment.

# The server's public HTTPS name. A hostname you own pointed at the VM (A record, DNS-only),
# or with no domain: <ip-with-dashes>.sslip.io, e.g. 140-238-1-2.sslip.io
API_DOMAIN=

# Password for the Postgres container (any long random string: `openssl rand -hex 24`).
POSTGRES_PASSWORD=

# Where the web app is served from (comma-separated if more than one), e.g.
# https://settlers-online.pages.dev,https://play.example.com
WEB_ORIGIN=

# Supabase project (sign-in). The server only needs the URL; it verifies tokens with the
# project's public signing keys.
SUPABASE_URL=
# Only if the project still uses a shared JWT secret:
# SUPABASE_JWT_SECRET=

# Which server image tag to run (set by scripts/deploy-server.sh).
SERVER_TAG=latest
