# Supabase — get these from your project dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Server
DATABASE_URL=postgresql://user:password@localhost:5432/settlers
WEB_ORIGIN=http://localhost:5173
PORT=3000

# Optional: only if the Supabase project still uses a shared JWT secret instead of signing keys
# SUPABASE_JWT_SECRET=

# Local development (put these in .env.local, which overrides .env)
# TEST_DATABASE_URL=postgresql://localhost:5432/settlers_test
# AUTH_MODE=dev            # adds dev sign-in; never in production
# SERVER_URL=http://localhost:3000   # web: game server URL when not localhost:PORT

# Production: the server's settings live in ~/settlers/.env on the VM (see deploy/env.example
# and docs/DEPLOY.md), not here. The web build gets SERVER_URL from scripts/deploy-web.sh.
# MIGRATIONS_DIR=          # server: where the SQL migrations are (set in the Docker image)
